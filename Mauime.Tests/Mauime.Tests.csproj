<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Mauime.Tests</RootNamespace>
  </PropertyGroup>

  <!--
    The Mauime libraries only. The legacy characterization lives in Legacy.Tests, which has to be a
    separate project because legacy/WebHostPatch's forked Microsoft.Extensions.Primitives shadows
    the real one for everything in its output directory.

    Mauime.Nfc resolves to its net10.0 slice here, which is the "no implementation" one. That covers
    the NDEF codec and the DI registration; the Android and iOS implementations are covered by the
    API baseline only, since a net10.0 test project cannot reference their slices.

    The baseline itself needs no references at all - it reads metadata off disk - so it covers the
    legacy assemblies from here too.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Mauime.Nfc\Mauime.Nfc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="7.2.2" />
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.0" />
  </ItemGroup>

</Project>
