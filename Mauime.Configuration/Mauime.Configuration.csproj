<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(MauimeTargetFrameworks)</TargetFrameworks>
    <UseMauiCore>true</UseMauiCore>
    <SingleProject>true</SingleProject>
    <AssemblyName>Mauime.Configuration</AssemblyName>
    <RootNamespace>Mauime.Configuration</RootNamespace>
    <PackageId>Mauime.Configuration</PackageId>
    <Description>appsettings.json configuration for .NET MAUI apps, from app package assets or embedded resources.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Microsoft.Maui.Core, not Microsoft.Maui.Controls: Core carries MauiAppBuilder, the
      LifecycleEvents builders and Microsoft.Maui.ApplicationModel, which is everything these
      libraries need. Microsoft.Maui.Essentials alone is not enough - it has none of them.
      Since .NET 8 the UseMaui* properties no longer add the package reference implicitly (MA002).
    -->
    <PackageReference Include="Microsoft.Maui.Core" Version="$(MauiVersion)" />

    <!--
      The one thing this package adds that an app could not already do in a line: MAUI references
      Microsoft.Extensions.Configuration but not the JSON provider, so builder.Configuration has no
      AddJsonStream. Pinned at 10.0.0 to match the Configuration that Microsoft.Maui.Core already
      resolves, rather than pulling the whole graph up a patch line as a side effect.

      Xamarinme vendored a copy of Microsoft's Newtonsoft-era parser instead, and it drifted. This
      is Microsoft's, maintained.
    -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
  </ItemGroup>

</Project>
