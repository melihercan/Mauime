<Project>

  <!--
    Shared build settings for everything except legacy/, which is shielded by its own empty
    Directory.Build.props so that the imported Xamarin sources keep building exactly as they did.
  -->

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    Public members are documented, so the XML file is generated and CS1591 holds it that way. This
    is the opposite of Blazorme, where the surface had no XML docs at all and turning this on would
    have emitted hundreds of warnings; here the docs came with the code. Test projects are excluded:
    their members are not API.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('Me.Toolkit.Maui.')) AND !$(MSBuildProjectName.EndsWith('.Tests'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Package identity that is the same for every library. What differs per package - Version,
    Product, Description, PackageTags, PackageReleaseNotes - stays in the csproj, so the four can
    be versioned and described independently.

    GeneratePackageOnBuild is deliberately absent: publishing is CI's job, and a local build should
    not litter bin/ with .nupkg files. Use `dotnet pack` when you want one. AssemblyVersion and
    FileVersion are left to derive from Version - Xamarinme.Configuration pinned AssemblyVersion at
    1.0.0 while shipping 1.0.3, so every 1.0.x assembly presented the same identity to the binder.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('Me.Toolkit.Maui.')) AND !$(MSBuildProjectName.EndsWith('.Tests'))">
    <Authors>melihercan</Authors>
    <Company>melihercan</Company>
    <Copyright>melihercan 2020-2026</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>me.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/melihercan/Me.Toolkit.Maui</PackageProjectUrl>
    <RepositoryUrl>https://github.com/melihercan/Me.Toolkit.Maui</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectName.StartsWith('Me.Toolkit.Maui.')) AND !$(MSBuildProjectName.EndsWith('.Tests'))">
    <None Include="$(MSBuildThisFileDirectory)doc\me.png" Pack="true" PackagePath="" Visible="false" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <!--
    The MAUI target frameworks, in one place rather than copied into four csprojs.
    Libraries opt in with <TargetFrameworks>$(MeToolkitMauiTargetFrameworks)</TargetFrameworks>;
    Me.Toolkit.Maui.Tests stays on plain net10.0 and ignores this.

    net10.0 is deliberately included alongside the platform frameworks: it is the slice a
    non-platform project can reference, and for Me.Toolkit.Maui.Nfc it is where "this platform has no
    implementation" lives. Xamarinme.Nfc used netstandard2.0 for the same role.
  -->
  <PropertyGroup Label="MAUI multi-targeting">
    <MeToolkitMauiTargetFrameworks>net10.0;net10.0-android</MeToolkitMauiTargetFrameworks>
    <MeToolkitMauiTargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(MeToolkitMauiTargetFrameworks);net10.0-ios;net10.0-maccatalyst</MeToolkitMauiTargetFrameworks>
    <MeToolkitMauiTargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(MeToolkitMauiTargetFrameworks);net10.0-windows10.0.19041.0</MeToolkitMauiTargetFrameworks>
  </PropertyGroup>

  <!--
    Android generates a public <RootNamespace>.Resource designer class into every library, even one
    with no Android resources at all. It would land in the public surface of all four packages, as a
    type no consumer can use and none should see - the same shape of wart as Razor's generated
    _Imports classes in Blazorme, except that this one has a knob. None of these libraries carries
    Android resources; a library that later does must turn this back on for itself.

    Scoped to the libraries: DemoApp is an Android *app*, and an app needs its resource designer.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('Me.Toolkit.Maui.')) AND !$(MSBuildProjectName.EndsWith('.Tests')) AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidGenerateResourceDesigner>false</AndroidGenerateResourceDesigner>
  </PropertyGroup>

  <!-- Evaluated per inner build, where TargetFramework is set as a global property. -->
  <PropertyGroup Label="Platform minimums">
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

</Project>
