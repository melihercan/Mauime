<Project>

  <!--
    Shared build settings for everything except legacy/, which is shielded by its own empty
    Directory.Build.props so that the imported Xamarin sources keep building exactly as they did.
  -->

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    The MAUI target frameworks, in one place rather than copied into four csprojs.
    Libraries opt in with <TargetFrameworks>$(MauimeTargetFrameworks)</TargetFrameworks>;
    Mauime.Tests stays on plain net10.0 and ignores this.

    net10.0 is deliberately included alongside the platform frameworks: it is the slice a
    non-platform project can reference, and for Mauime.Nfc it is where "this platform has no
    implementation" lives. Xamarinme.Nfc used netstandard2.0 for the same role.
  -->
  <PropertyGroup Label="MAUI multi-targeting">
    <MauimeTargetFrameworks>net10.0;net10.0-android</MauimeTargetFrameworks>
    <MauimeTargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(MauimeTargetFrameworks);net10.0-ios;net10.0-maccatalyst</MauimeTargetFrameworks>
    <MauimeTargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(MauimeTargetFrameworks);net10.0-windows10.0.19041.0</MauimeTargetFrameworks>
  </PropertyGroup>

  <!--
    Android generates a public <RootNamespace>.Resource designer class into every library, even one
    with no Android resources at all. It would land in the public surface of all four packages, as a
    type no consumer can use and none should see - the same shape of wart as Razor's generated
    _Imports classes in Blazorme, except that this one has a knob. None of these libraries carries
    Android resources; a library that later does must turn this back on for itself.
  -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidGenerateResourceDesigner>false</AndroidGenerateResourceDesigner>
  </PropertyGroup>

  <!-- Evaluated per inner build, where TargetFramework is set as a global property. -->
  <PropertyGroup Label="Platform minimums">
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

</Project>
